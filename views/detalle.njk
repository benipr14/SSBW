{% extends "base.njk" %}

{% block content %}
  <div class="row g-4 align-items-start">
    <div class="col-md-6">
      <img src="/public/imagenes/{{ item.imagen }}" class="img-fluid rounded shadow-sm" alt="{{ item.titulo }}">
    </div>
    <div class="col-md-6">
      <p class="text-uppercase text-secondary small mb-1">Producto</p>
      <h1 class="fw-bold mb-2">{{ item.titulo }}</h1>
      <p class="lead">{{ item.descripcion }}</p>
      <p class="h4 text-primary fw-bold">{{ item.precio | round(2) }} €</p>
      <form class="mt-3 d-flex align-items-center gap-2" action="/al-carrito/{{ item.id }}" method="POST">
        <label class="form-label mb-0" for="cantidad">Cantidad</label>
        <input class="form-control" style="max-width: 120px;" type="number" min="1" name="cantidad" id="cantidad" value="1" required>
        <button class="btn btn-success" type="submit">Añadir a la cesta</button>
        <a class="btn btn-outline-secondary" href="/">Volver a la portada</a>
      </form>
    </div>
  </div>
{% endblock %}
