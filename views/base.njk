<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle or "Tienda Prado" }}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="bg-light text-dark">
  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">Tienda Prado</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navContent" aria-controls="navContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navContent">
        <form class="d-flex ms-auto" method="get" action="/buscar">
          <input class="form-control me-2" type="search" name="busqueda" placeholder="Buscar" value="{{ busqueda or '' }}" aria-label="Buscar">
          <button class="btn btn-primary" type="submit">Buscar</button>
        </form>
        <div class="ms-3 d-flex align-items-center gap-2">
          {% if usuario %}
            <span class="text-muted small">Hola, {{ usuario }}</span>
            <a class="btn btn-outline-secondary" href="/logout">Cerrar sesión</a>
          {% else %}
            <a class="btn btn-outline-primary" href="/login">Iniciar sesión</a>
          {% endif %}
          <button class="btn btn-outline-secondary position-relative" id="abrirCarrito" type="button" data-bs-toggle="offcanvas" data-bs-target="#carritoOffcanvas" aria-controls="carritoOffcanvas" aria-label="Abrir carrito">
            🛒
            <span id="badgeCarrito" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger {% if not total_carrito or total_carrito <= 0 %}d-none{% endif %}">{{ total_carrito or 0 }}</span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <div class="offcanvas offcanvas-end" tabindex="-1" id="carritoOffcanvas" aria-labelledby="carritoOffcanvasLabel">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title" id="carritoOffcanvasLabel">Tu carrito</h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
    </div>
    <div class="offcanvas-body">
      <div id="carritoVacio" class="text-muted small">No hay productos en el carrito.</div>
      <div id="carritoLista" class="d-grid gap-2"></div>
      <div class="border-top mt-3 pt-3 d-flex justify-content-between">
        <span class="fw-semibold">Total</span>
        <span id="carritoTotal">0,00 €</span>
      </div>
    </div>
  </div>

  <template id="tplCarritoItem">
    <article class="border rounded p-2 d-flex gap-2 align-items-start">
      <img data-field="imagen" src="" alt="" width="52" height="52" class="rounded object-fit-cover">
      <div class="flex-grow-1">
        <div class="fw-semibold" data-field="titulo"></div>
        <div class="small text-muted" data-field="detalle"></div>
      </div>
      <button type="button" class="btn btn-sm btn-outline-danger" data-action="eliminar">Eliminar</button>
    </article>
  </template>

  <main class="py-4">
    <div class="container">
      {% block content %}{% endblock %}
    </div>
  </main>

  <footer class="border-top bg-white py-3 mt-4">
    <div class="container text-muted small">
      Portada y búsquedas · SSBW
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  <script src="/carrito-offcanvas.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
