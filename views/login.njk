{% extends "base.njk" %}

{% block content %}
<div class="row justify-content-center">
  <div class="col-md-6 col-lg-4">
    <div class="card shadow-sm">
      <div class="card-body">
        <h1 class="h4 mb-3 text-center">Iniciar sesión</h1>
        {% if error %}
          <div class="alert alert-danger">{{ errorMessage or "Credenciales inválidas. Inténtalo de nuevo." }}</div>
        {% endif %}
        <form method="POST" action="/login" id="loginForm" novalidate>
          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" class="form-control" id="email" name="email" value="{{ oldEmail or '' }}" placeholder="ejemplo@correo.com" autocomplete="username" inputmode="email" required autofocus>
            <div class="invalid-feedback">Introduce un email válido.</div>
          </div>
          <div class="mb-3">
            <label for="contraseña" class="form-label">Contraseña</label>
            <input type="password" class="form-control" id="contraseña" name="contraseña" placeholder="Tu contraseña" autocomplete="current-password" minlength="6" required>
            <div class="form-text">Debe tener al menos 6 caracteres.</div>
            <div class="invalid-feedback">La contraseña debe tener al menos 6 caracteres.</div>
          </div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" value="1" id="mostrarPassword">
            <label class="form-check-label" for="mostrarPassword">
              Mostrar contraseña
            </label>
          </div>
          <button type="submit" class="btn btn-primary w-100">Entrar y ver catálogo</button>
        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script>
  (function () {
    const form = document.getElementById("loginForm");
    const emailInput = document.getElementById("email");
    const passwordInput = document.getElementById("contraseña");
    const showPassword = document.getElementById("mostrarPassword");

    if (!form || !emailInput || !passwordInput || !showPassword) {
      return;
    }

    const validateField = (field) => {
      field.classList.toggle("is-invalid", !field.checkValidity());
    };

    emailInput.addEventListener("blur", () => validateField(emailInput));
    passwordInput.addEventListener("blur", () => validateField(passwordInput));

    form.addEventListener("submit", (event) => {
      validateField(emailInput);
      validateField(passwordInput);
      if (!form.checkValidity()) {
        event.preventDefault();
      }
    });

    showPassword.addEventListener("change", () => {
      passwordInput.type = showPassword.checked ? "text" : "password";
    });
  })();
</script>
{% endblock %}
